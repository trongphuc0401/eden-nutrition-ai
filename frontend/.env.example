# Server-side: where Next.js proxies /api/* (e.g. https://fresh-citrus-api.onrender.com on Vercel).
BACKEND_URL=http://localhost:8000
# Browser-side API base. Keep /api so cookies stay first-party via the proxy.
NEXT_PUBLIC_API_URL=/api
# demo = no backend calls; live = real backend + Google sign-in. Baked in at build time.
NEXT_PUBLIC_APP_MODE=demo
