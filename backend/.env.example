APP_NAME=AI Nutrition Coach API
APP_ENV=local
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_nutrition

# Provider configuration used by legacy smoothie endpoints.
LLM_PROVIDER=zai
LLM_API_KEY=
LLM_MODEL=glm-4.7-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Embeddings provider for pgvector import/search
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EMBEDDING_DIMENSIONALITY=1536

# Backward-compatible OpenAI fields kept for older scripts and local fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Report recipe generation. Use mock only for local workflow tests.
REPORT_RECIPE_MODE=mock
REPORT_MODEL_TIMEOUT_SECONDS=45
REPORT_MODEL_MAX_RETRIES=1
REPORT_RECIPE_MAX_REPAIRS=2
REPORT_JOB_ACTIVE_TIMEOUT_SECONDS=180
REPORT_JOB_PERSISTENCE_ENABLED=false

ZAI_API_KEY=
ZAI_MODEL=glm-4.7-flash
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# CORS (only needed when the frontend calls the API directly, not via the /api proxy)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Generated PDF reports. On Render this points at the persistent disk.
PDF_OUTPUT_DIR=

# Google sign-in. Redirect URI goes through the frontend /api proxy so the
# session cookie is first-party on the frontend domain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
SESSION_SECRET=
# Keep this true when FastAPI is local but Vercel serves the browser-facing
# HTTPS domain through a tunnel.
SESSION_COOKIE_SECURE=true
FRONTEND_URL=http://localhost:3000

# Max reports a signed-in user may start per hour (protects LLM quota)
REPORT_RATE_LIMIT_PER_HOUR=10
