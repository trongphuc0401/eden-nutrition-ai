# Fresh Citrus — Sprint 1 configuration
# Copy this file to .env. Keep real values out of Git.
APP_NAME=AI Nutrition Coach API
APP_ENV=local
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required for live generation
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Required before enabling Google sign-in in a deployed environment
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback
SESSION_SECRET=
FRONTEND_URL=http://localhost:3000
